{
  "name": "ngajiku",
  "version": "1.0.0",
  "description": "Aplikasi Absensi Pengajian Offline-First",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "build:raspi": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux deb --arm64",
    "build:raspi-dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux dir --arm64",
    "build:all": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --linux --arm64",
    "postinstall": "electron-builder install-app-deps",
    "generate-icons": "node generate-icons.js"
  },
  "author": "Iban dan Rasyad",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "sql.js": "^1.9.0"
  },
  "build": {
    "appId": "com.ngajiku.absensi",
    "productName": "Ngajiku",
    "copyright": "Copyright © 2024 Iban dan Rasyad",
    "icon": "icons/icon.png",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.exe",
      "publisherName": "Iban dan Rasyad"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ngajiku",
      "perMachine": false,
      "runAfterFinish": true,
      "installerSidebar": null,
      "license": null
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icons/",
      "category": "Utility",
      "maintainer": "Iban dan Rasyad",
      "vendor": "Ngajiku Team",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
