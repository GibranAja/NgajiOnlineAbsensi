{
  "name": "ngajiku",
  "version": "1.0.0",
  "description": "Aplikasi Absensi Pengajian Offline-First",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux --armv7l",
    "build:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Ngajiku Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sql.js": "^1.9.0"
  },
  "build": {
    "appId": "com.ngajiku.absensi",
    "productName": "Ngajiku",
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.cache/**/*"
    ]
  }
}
