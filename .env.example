# S3-Compatible Object Storage Configuration
# Copy this file to .env and fill in your credentials

# S3 Access Key
S3_ACCESS_KEY=your_access_key_here

# S3 Secret Key
S3_SECRET_KEY=your_secret_key_here

# S3 Service URL (endpoint)
S3_SERVICE_URL=https://is3.cloudhost.id

# S3 Bucket Name
S3_BUCKET_NAME=ngajiku-photos

# S3 Region (for S3-compatible services, can be any value)
S3_REGION=us-east-1
